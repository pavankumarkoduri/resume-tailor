# Copy this file to .streamlit/secrets.toml for LOCAL testing of the hosted
# (cloud LLM) code path. On Streamlit Community Cloud, you do NOT upload this
# file — instead paste the same keys into the app's Settings -> Secrets panel
# in the web UI after deploying.
#
# Never commit a real secrets.toml to git (.gitignore already excludes it).

LLM_API_KEY = "sk-...your real OpenAI key..."
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL = "gpt-4o-mini"
